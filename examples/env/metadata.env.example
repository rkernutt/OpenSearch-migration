# =============================================================================
# Copy to repo root as:  .env  (or merge into existing .env)
# Used by: metadata_migration.migrator + metadata_migration.sanitizer
#          (also accessible as `migrate metadata` and `migrate sanitize`).
# Migrate templates / component templates / index templates / ingest pipelines
# from OpenSearch (or any ES-compatible cluster) to Elastic, with optional
# Serverless settings sanitization and ES 5/6 multi-type mapping flatten.
# Run BEFORE the data path so destination indices are created with the right
# settings/mappings on first write.
# =============================================================================

# --- Source: OpenSearch (read-only) ---
SOURCE_OPENSEARCH_HOST=https://search-your-domain-id.region.es.amazonaws.com
AWS_REGION=us-east-1

# Optional: fine-grained user/password for the source instead of SigV4.
# SOURCE_OPENSEARCH_USER=admin
# SOURCE_OPENSEARCH_PASSWORD=your-opensearch-password

# --- Target: Elasticsearch (Hosted or Serverless) ---
DEST_ELASTIC_HOST=https://your-deployment-id.es.region.aws.found.io
DEST_ELASTIC_API_KEY=your-elastic-api-key-value

# Or username/password instead of API key (comment out DEST_ELASTIC_API_KEY):
# DEST_ELASTIC_USER=elastic
# DEST_ELASTIC_PASSWORD=your-elastic-password

# =============================================================================
# Example commands (after: pip install -r requirements.txt; pip install -e .)
# =============================================================================
# Dry-run everything to a Serverless destination (writes per-object reports):
#
#   migrate metadata \
#     --target-type ELASTICSEARCH_SERVERLESS \
#     --include templates,index_templates,component_templates,ingest_pipelines \
#     --report-dir ./metadata-report \
#     --dry-run --strict-exit-codes --log-format json
#
# Apply only one template by name, with overwrite:
#
#   migrate metadata \
#     --include index_templates --name 'logs-*' \
#     --overwrite --strict-exit-codes
#
# Sanitize a single index body (e.g. before pre-creating an index):
#
#   migrate sanitize --mode index-body --target-type ELASTICSEARCH_SERVERLESS \
#     < my-template.json > my-template.serverless.json
