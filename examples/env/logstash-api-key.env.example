# =============================================================================
# Copy contents into repo root  .env
# Run from Logstash_input/:  docker compose --profile apikey up --build
# Uses pipeline with hosts + api_key (no ELASTIC_CLOUD_ID).
# =============================================================================

# --- Source: OpenSearch ---
SOURCE_OPENSEARCH_HOST=https://search-your-domain-id.region.es.amazonaws.com
AWS_REGION=us-east-1
# SOURCE_OPENSEARCH_USER=admin
# SOURCE_OPENSEARCH_PASSWORD=your-opensearch-password

LOGSTASH_SOURCE_INDEX=source-index-name
LOGSTASH_DEST_INDEX=destination-index-name

# --- Target: Elasticsearch (URL + API key — same vars as validate_migration.py) ---
DEST_ELASTIC_HOST=https://your-deployment-id.es.region.aws.found.io
DEST_ELASTIC_API_KEY=your-elastic-api-key-value
