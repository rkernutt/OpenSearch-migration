# =============================================================================
# Copy to repo root as:  .env  (or merge into existing .env)
# Used by: Proxy/app.py with capture mode enabled.
# Tees every proxied request and response to NDJSON for later replay.
# Pair with replay/replayer.py (see examples/env/replay.env.example).
#
# Capture is OFF by default (PROXY_CAPTURE_MODE=off). Set the mode below to
# `local` (rotating files on disk) or `s3` (gzipped batches in S3).
#
# See:  Proxy/README.md (Capture mode section) and docs/CAPTURE_REPLAY.md
# =============================================================================

# --- Required for the proxy itself (regardless of capture) ---
OPENSEARCH_ENDPOINT=https://vpc-your-domain-xxx.region.es.amazonaws.com
AWS_REGION=us-east-1

# Optional basic auth in front of the proxy (recommended when public).
# PROXY_USER=proxy-basic-auth-user
# PROXY_PASSWORD=replace-with-proxy-password

# --- Capture mode ---
# off  : disabled (default).
# local: write rotating NDJSON files to PROXY_CAPTURE_DIR.
# s3   : upload gzipped NDJSON batches to PROXY_CAPTURE_S3_URI.
PROXY_CAPTURE_MODE=local

# Local-mode destination (created if missing).
PROXY_CAPTURE_DIR=/var/log/proxy-capture

# S3-mode destination (only used when PROXY_CAPTURE_MODE=s3).
# PROXY_CAPTURE_S3_URI=s3://my-cap-bucket/proxy/

# --- Filtering (defaults are permissive) ---
# Comma-separated regex patterns. Only paths matching at least one INCLUDE and
# none of EXCLUDE are captured. Defaults: INCLUDE=.*, EXCLUDE=(empty).
# PROXY_CAPTURE_PATH_INCLUDE=/_search,/_msearch
# PROXY_CAPTURE_PATH_EXCLUDE=/_cluster/.*,/_nodes/.*

# Methods to capture (default GET,POST,HEAD).
# PROXY_CAPTURE_METHODS=GET,POST

# --- Body handling ---
# Inline cap per body, in bytes. Bodies above this are stored as size + SHA-256
# only. Default 1048576 (1 MiB).
# PROXY_CAPTURE_MAX_BODY_BYTES=1048576

# Set to false to never store body bytes inline (sizes + hashes only). Default true.
# PROXY_CAPTURE_INCLUDE_BODIES=true

# --- Rotation and queue ---
# Local mode rotates by size (bytes) OR time (seconds) — whichever first.
# PROXY_CAPTURE_ROTATE_BYTES=104857600   # 100 MiB
# PROXY_CAPTURE_ROTATE_SECONDS=60

# Bounded in-process queue. If full, records drop with a counter. Default 10000.
# PROXY_CAPTURE_QUEUE=10000
