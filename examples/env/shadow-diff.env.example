# =============================================================================
# Copy to repo root as:  .env  (or merge into existing .env)
# Used by: shadow_diff.py  (also `migrate shadow-diff`).
# Replays a list of saved queries against source + dest in parallel and exits
# non-zero on drift (count, top-K hit IDs, top-K _source SHA-256). Run AFTER
# the data path and BEFORE flipping production traffic.
# =============================================================================

# --- Source: OpenSearch ---
SOURCE_OPENSEARCH_HOST=https://search-your-domain-id.region.es.amazonaws.com
AWS_REGION=us-east-1

# Optional: fine-grained user/password instead of SigV4.
# SOURCE_OPENSEARCH_USER=admin
# SOURCE_OPENSEARCH_PASSWORD=your-opensearch-password

# --- Destination: Elasticsearch (Hosted or Serverless) ---
DEST_ELASTIC_HOST=https://your-deployment-id.es.region.aws.found.io
DEST_ELASTIC_API_KEY=your-elastic-api-key-value

# Or username/password instead of API key:
# DEST_ELASTIC_USER=elastic
# DEST_ELASTIC_PASSWORD=your-elastic-password

# =============================================================================
# Query file format (cutover-queries.json):
#   [
#     {
#       "name": "logs_last_24h",
#       "source_index": "logs-2024",
#       "dest_index":   "logs-2024",
#       "body": { "query": { "match_all": {} } }
#     },
#     ...
#   ]
# `dest_index` is optional — defaults to `source_index`. You can also pass a
# directory of *.json files via --queries-dir.
# =============================================================================

# Example commands:
#
#   migrate shadow-diff \
#     --queries-file ./cutover-queries.json \
#     --top-k 100 \
#     --count-tolerance 0.001 \
#     --topk-id-threshold 0.95 \
#     --topk-hash-threshold 0.95 \
#     --workers 4 \
#     --report ./shadow-diff-report.json \
#     --strict-exit-codes --log-format json
