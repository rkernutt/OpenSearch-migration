# =============================================================================
# Copy contents into repo root  .env  (merge with validation vars if needed)
# Run from Logstash_input/:  docker compose up --build
# Requires: Docker
# =============================================================================

# --- Source: OpenSearch (same as validation) ---
SOURCE_OPENSEARCH_HOST=https://search-your-domain-id.region.es.amazonaws.com
AWS_REGION=us-east-1
# SOURCE_OPENSEARCH_USER=admin
# SOURCE_OPENSEARCH_PASSWORD=your-opensearch-password

# --- Indices (read from OpenSearch, write to Elastic) ---
LOGSTASH_SOURCE_INDEX=source-index-name
LOGSTASH_DEST_INDEX=destination-index-name

# --- Target: Elastic Cloud (Deployment UI) ---
ELASTIC_CLOUD_ID=your_deployment_name:base64CloudIdStringFromElasticCloud
ELASTIC_CLOUD_AUTH=elastic:your-elastic-cloud-password

# --- Optional: also set for validate_migration.py from the same .env ---
DEST_ELASTIC_HOST=https://your-deployment-id.es.region.aws.found.io
DEST_ELASTIC_API_KEY=your-elastic-api-key-value
