# =============================================================================
# Copy to repo root as:  .env
# Used by: validate_migration.py, poll_reindex_task.py
# Index names are NOT in this file — pass them on the command line (see below).
# =============================================================================

# --- Source: OpenSearch ---
SOURCE_OPENSEARCH_HOST=https://search-your-domain-id.region.es.amazonaws.com

# Amazon OpenSearch with IAM master user / SigV4 from your machine:
AWS_REGION=us-east-1

# If the domain uses fine-grained access with a master user/password, set these
# (SigV4 is skipped when both are set):
# SOURCE_OPENSEARCH_USER=admin
# SOURCE_OPENSEARCH_PASSWORD=your-opensearch-password

# --- Target: Elasticsearch (Elastic Cloud or self-managed) ---
DEST_ELASTIC_HOST=https://your-deployment-id.es.region.aws.found.io
DEST_ELASTIC_API_KEY=your-elastic-api-key-value

# Or username/password instead of API key (comment out DEST_ELASTIC_API_KEY):
# DEST_ELASTIC_USER=elastic
# DEST_ELASTIC_PASSWORD=your-elastic-password

# =============================================================================
# Example commands (after: pip install -r requirements.txt)
# =============================================================================
# python validate_migration.py \
#   --source-index SOURCE_INDEX_NAME \
#   --dest-index DEST_INDEX_NAME
#
# python poll_reindex_task.py --task-id "node_id:12345"
