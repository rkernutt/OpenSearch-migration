# =============================================================================
# Copy contents into repo root .env
# Run from Logstash_input/:  docker compose --profile s3 up --build
# Reads NDJSON parts from S3 and writes them to Elastic Cloud.
# =============================================================================

# --- S3 source ---
S3_BUCKET=my-migration-bucket
S3_PREFIX=migration/2026-04-29/data/
AWS_REGION=us-east-1
# AWS credentials: leave blank to use the container task role / EC2 instance
# role / shared credentials file. Set explicitly only for local dev.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional: drop @timestamp from outgoing docs (default false).
# LOGSTASH_REMOVE_TIMESTAMP=true

# Optional: copy processed objects to a backup directory inside the container
# (mount a host or NFS path through compose if you need durability).
# S3_BACKUP_DIR=/usr/share/logstash/data/processed

# --- Target: Elastic Cloud (cloud_id flavour) ---
ELASTIC_CLOUD_ID=your-deployment:base64-blob
ELASTIC_CLOUD_AUTH=elastic:your-elastic-password
LOGSTASH_DEST_INDEX=destination-index-name

# --- Target: Elastic Cloud (API key flavour) ---
# Comment out the ELASTIC_CLOUD_* lines above and uncomment these, then edit
# pipeline/logstash_s3.conf to use `hosts` + `api_key` (the file already has
# the relevant lines commented in).
# DEST_ELASTIC_HOST=https://your-deployment-id.es.region.aws.found.io
# DEST_ELASTIC_API_KEY=your-elastic-api-key-value
