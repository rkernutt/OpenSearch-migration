# =============================================================================
# Copy to repo root as:  .env  (or merge into existing .env)
# Used by: replay/replayer.py  (also `migrate replay`).
# Reads NDJSON capture files produced by Proxy/capture.py and replays them
# against the destination, comparing each replayed response to the original.
# Pair with examples/env/proxy-capture.env.example (the producer side).
# =============================================================================

# --- Destination: Elasticsearch (Hosted or Serverless) ---
DEST_ELASTIC_HOST=https://your-deployment-id.es.region.aws.found.io
DEST_ELASTIC_API_KEY=your-elastic-api-key-value

# Or username/password instead of API key:
# DEST_ELASTIC_USER=elastic
# DEST_ELASTIC_PASSWORD=your-elastic-password

# --- Capture source ---
# AWS_REGION is used both for SigV4 (if needed) and for S3 capture sources.
AWS_REGION=us-east-1

# =============================================================================
# Example commands:
# =============================================================================
#
# Local capture directory, GET-only, dry-rate-limited, full report:
#
#   migrate replay \
#     --captures /var/log/proxy-capture/ \
#     --method GET \
#     --workers 4 --rate-limit 25 \
#     --size-tolerance 0.05 \
#     --report ./replay-report.json \
#     --strict-exit-codes --log-format json
#
# S3 capture prefix, sample of 5000 _search requests in a 1-hour window:
#
#   migrate replay \
#     --captures s3://my-cap-bucket/proxy/2026-04-29/ \
#     --method GET \
#     --path-include '/_search' --path-include '/_msearch' \
#     --since 2026-04-29T12:00:00Z --until 2026-04-29T13:00:00Z \
#     --max-requests 5000 \
#     --workers 8 --rate-limit 50 \
#     --report ./replay-report.json \
#     --strict-exit-codes --log-format json
#
# Skip body-hash check (e.g. when the destination has different `took` values
# but identical `hits.total`):
#
#   migrate replay --captures ... --no-hash-check ...
