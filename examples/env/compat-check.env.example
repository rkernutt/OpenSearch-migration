# =============================================================================
# Copy to repo root as:  .env  (or merge into existing .env)
# Used by: compat_check.py  (also `migrate compat-check`).
# Run BEFORE picking a data path. Reports source/destination version skew,
# OpenSearch-specific Lucene formats (k-NN, ZSTD codec), and ES 5/6-era
# mapping artefacts so you know which paths in this repo are safe.
# =============================================================================

# --- Source: OpenSearch (or ES) ---
SOURCE_OPENSEARCH_HOST=https://search-your-domain-id.region.es.amazonaws.com
AWS_REGION=us-east-1

# Optional: fine-grained user/password instead of SigV4.
# SOURCE_OPENSEARCH_USER=admin
# SOURCE_OPENSEARCH_PASSWORD=your-opensearch-password

# --- Destination: Elasticsearch (optional but recommended) ---
# When set, adds Lucene-major / Serverless cross-checks that wouldn't fire
# from a source-only probe. Skip if you don't yet have a destination URL.
DEST_ELASTIC_HOST=https://your-deployment-id.es.region.aws.found.io
DEST_ELASTIC_API_KEY=your-elastic-api-key-value

# Or username/password instead of API key:
# DEST_ELASTIC_USER=elastic
# DEST_ELASTIC_PASSWORD=your-elastic-password

# =============================================================================
# Example commands:
#
#   # Full report against a live source + destination, JSON for CI.
#   migrate compat-check \
#     --report ./compat-report.json \
#     --strict-exit-codes --log-format json
#
#   # Limit the scan to a few candidate indices.
#   migrate compat-check \
#     --include "logs-*" --include "events-*" \
#     --exclude "*-shadow"
#
#   # Source-only (no destination yet); still flags k-NN, codecs, mappings.
#   migrate compat-check --source-host "$SOURCE_OPENSEARCH_HOST"
#
#   # Force the Serverless-forbidden-settings check even without a dest.
#   migrate compat-check --target-type ELASTICSEARCH_SERVERLESS
#
# Exit codes (with --strict-exit-codes):
#   0  clean — any path works
#   2  misconfiguration (missing host/auth)
#   3  network / auth failure on source or destination
#   4  compatibility issues — see report; Path B / D still safe, RFS caveated
# =============================================================================
